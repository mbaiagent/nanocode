# 控制面和模型网关共用一个镜像，用参数区分：control 或 gateway（不带参数 = 两个都在一个进程里）。
# 构建（在仓库根目录）：docker build -f deploy/Dockerfile.server -t nanocode-server:latest .
FROM python:3.12-slim

# 可选组件的驱动：PostgreSQL（NCS_DATABASE_URL）和 Redis（NCS_REDIS_URL）。不用的话可以去掉
ARG EXTRAS="psycopg[binary] redis"
RUN if [ -n "$EXTRAS" ]; then pip install --no-cache-dir $EXTRAS; fi

# nanocode 和控制面都只用标准库，直接放进镜像
COPY nanocode /opt/nanocode/nanocode
COPY server/nanocode_server /opt/nanocode/nanocode_server
ENV PYTHONPATH=/opt/nanocode PYTHONDONTWRITEBYTECODE=1 NCS_DATA_DIR=/data

RUN groupadd -g 10001 ncs && useradd -u 10001 -g ncs -M -s /usr/sbin/nologin ncs && mkdir /data && chown ncs:ncs /data
USER 10001:10001
ENTRYPOINT ["python", "-m", "nanocode_server"]
CMD ["control"]
