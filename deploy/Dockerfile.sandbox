# 沙箱镜像：每个会话一个容器，里面只跑 `nanocode --web`。
# 运行时由启动器（Docker / Kubernetes）设置：非 root（10001）、只读根文件系统、去掉全部 capabilities；
# 工作区和 NANOCODE_HOME 在 /data 上，平台策略只读挂载在 /etc/nanocode/policy.json。
# 构建（在仓库根目录）：docker build -f deploy/Dockerfile.sandbox -t nanocode-sandbox:latest .
FROM python:3.12-slim

# Agent 常用的命令行工具。按需要增减（编译器、Node.js 等），固定版本并定期重建、扫描漏洞
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep \
 && rm -rf /var/lib/apt/lists/*

# nanocode 只用标准库，直接放进镜像，不需要 pip（构建时不用联网下载 Python 包）
COPY nanocode /opt/nanocode/nanocode
ENV PYTHONPATH=/opt/nanocode PYTHONDONTWRITEBYTECODE=1

RUN groupadd -g 10001 agent && useradd -u 10001 -g agent -d /data/home -s /bin/bash agent
USER 10001:10001
WORKDIR /data/workspace
EXPOSE 8765
ENTRYPOINT ["python", "-m", "nanocode"]
CMD ["--web", "--host", "0.0.0.0", "--port", "8765", "--cwd", "/data/workspace"]
