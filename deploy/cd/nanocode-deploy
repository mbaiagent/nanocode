#!/usr/bin/env bash
# nanocode 服务器端部署脚本（CD，见 docs/cd.md）。以 root 运行，只能经 sudo 由 nanocode-deploy-ssh 调用或人工执行。
#
#   nanocode-deploy deploy <40 位 commit sha>   下载该提交 → 新版本目录 → 切换 → 重建 → 健康检查，失败自动回滚
#   nanocode-deploy rollback                    切回上一个版本目录并重建
#   nanocode-deploy status                      打印当前版本和保留的版本
#
# 配置：/etc/nanocode-deploy.conf（root 所有，不进仓库），示例见 deploy/cd/nanocode-deploy.conf.example。
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONF="${NANOCODE_DEPLOY_CONF:-/etc/nanocode-deploy.conf}"
[ "$(id -u)" = 0 ] || { echo "必须以 root 运行" >&2; exit 2; }
[ -f "$CONF" ] && [ ! -L "$CONF" ] && [ "$(stat -c %u "$CONF")" = 0 ] || { echo "缺少 root 所有的 $CONF" >&2; exit 2; }
[ -z "$(find "$CONF" -perm /022)" ] || { echo "$CONF 不能是组 / 其他人可写" >&2; exit 2; }
# shellcheck source=/dev/null
. "$CONF"

: "${ROLE:?}" "${LIVE:?}" "${RELEASES:?}" "${COMPOSE_DIR:?}" "${REPO:?}"
CARRY="${CARRY:-}"            # 相对 LIVE 的文件，跨版本保留（.env、override 等）
KEEP="${KEEP:-3}"
BRANCH="${BRANCH:-main}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-120}"
LOCK=/run/nanocode-deploy.lock
HEALTHY="$RELEASES/.healthy"   # 只记录健康检查通过的版本目录（一行一个，最新在最后）；rollback / prune 只看它

tmp=""; new=""
cleanup() { [ -n "$tmp" ] && rm -rf -- "$tmp"; return 0; }
trap cleanup EXIT

log() { printf '[nanocode-deploy %s] %s\n' "$(date '+%F %T %Z')" "$*"; }
die() { log "错误：$*"; exit 1; }

valid_sha() { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }
valid_repo() { [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; }
valid_repo || die "REPO 格式不对"

current_dir() { [ -L "$LIVE" ] && readlink -f "$LIVE" || true; }

# 第一次运行：LIVE 还是普通目录（以前 git archive 解出来的），挪进 RELEASES 再换成软链接
migrate() {
  mkdir -p "$RELEASES"; chmod 755 "$RELEASES"
  if [ -d "$LIVE" ] && [ ! -L "$LIVE" ]; then
    local tag; tag="$(tr -dc '0-9a-f' < "$LIVE/DEPLOYED_COMMIT" 2>/dev/null | head -c 40 || true)"
    local dst="$RELEASES/${tag:-unknown}-migrated-$(date +%Y%m%d%H%M%S)"
    log "迁移现有目录 $LIVE → $dst"
    [ ! -s "$HEALTHY" ] || log "警告：$LIVE 被换成了普通目录（有人手动 git clone / 解包？）。CARRY 文件会从健康历史里补；手动升级请用 nanocode-deploy deploy"
    mv "$LIVE" "$dst"; ln -s "$dst" "$LIVE"
  fi
  # 历史文件不存在时，把当前（正在跑、视为健康的）版本记进去
  if [ ! -s "$HEALTHY" ] && [ -L "$LIVE" ]; then readlink -f "$LIVE" > "$HEALTHY"; fi
}

mark_healthy() {   # 追加到历史末尾（去掉旧的同名行），只保留存在的目录
  local d="$1" t; t="$(mktemp "$RELEASES/.healthy.XXXX")"
  { grep -vxF "$d" "$HEALTHY" 2>/dev/null || true; echo "$d"; } | while read -r l; do [ -d "$l" ] && echo "$l"; done > "$t"
  chmod 644 "$t"; mv -f "$t" "$HEALTHY"
}

discard() {   # 删掉失败 / 半截的版本目录
  [ -n "$1" ] && [ -d "$1" ] && [ "$1" != "$(current_dir)" ] && { log "删除失败版本 $1"; rm -rf --one-file-system -- "$1"; }
  return 0
}

carry_source() {   # $1 = 当前版本，$2 = CARRY 文件；先找当前版本，再按健康历史从新到旧找，打印找到的目录
  local prev="$1" f="$2" d
  if [ -n "$prev" ] && [ -e "$prev/$f" ]; then echo "$prev"; return 0; fi
  while read -r d; do
    [ -n "$d" ] && [ -e "$d/$f" ] && { echo "$d"; return 0; }
  done < <(tac "$HEALTHY" 2>/dev/null || true)
  return 1
}

switch_to() {   # 原子换软链接
  ln -sfn "$1" "$LIVE.tmp-link"; mv -T "$LIVE.tmp-link" "$LIVE"
}

compose() { (cd "$LIVE/$COMPOSE_DIR" && docker compose "$@"); }

rebuild() {
  case "$ROLE" in
    platform) compose build platform && compose up -d platform ;;
    sandbox)  compose up -d --build ;;
    *) die "未知 ROLE=$ROLE" ;;
  esac
}

healthz_ok() {   # $1 = url，$2.. = 必须出现的 JSON 片段
  local url="$1" body; shift
  body="$(curl -fsS --max-time 5 "$url" 2>/dev/null)" || return 1
  body="${body// /}"
  local need; for need in "$@"; do [[ "$body" == *"$need"* ]] || return 1; done
}

health() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT))
  case "$ROLE" in
    platform)
      until healthz_ok "${HEALTH_URL:-http://127.0.0.1:8700/healthz}" '"ok":true' '"launcher":"remote"' '"isolated":true'; do
        [ $SECONDS -lt $deadline ] || { log "平台 healthz 超时"; return 1; }; sleep 3; done
      if [ -n "${AGENT_HEALTH_URL:-}" ]; then healthz_ok "$AGENT_HEALTH_URL" '"ok":true' || { log "到沙箱代理不通"; return 1; }; fi ;;
    sandbox)
      until healthz_ok "${HEALTH_URL:?}" '"ok":true'; do
        [ $SECONDS -lt $deadline ] || { log "沙箱代理 healthz 超时"; return 1; }; sleep 3; done
      bash "$LIVE/deploy/firewall/check-sandbox-isolation.sh" || { log "沙箱隔离检查没过"; return 1; } ;;
  esac
  log "健康检查通过"
}

prune() {   # 保留历史里最近 KEEP 个健康版本 + 当前版本，其余目录（含不在历史里的）都删
  local cur keep d; cur="$(current_dir)"
  keep="$(tail -n "$KEEP" "$HEALTHY" 2>/dev/null; echo "$cur")"
  for d in "$RELEASES"/*/; do
    d="${d%/}"; [ -d "$d" ] || continue
    grep -qxF "$d" <<<"$keep" && continue
    log "清理旧版本 $d"; rm -rf --one-file-system -- "$d"
  done
  mark_healthy "$cur"   # 顺带把历史里已删除的目录去掉（cur 已在末尾时不变）
}

on_main() {   # sha 必须是 BRANCH 上的提交（compare: sha...BRANCH 为 ahead / identical）
  local out
  out="$(curl -fsS --max-time 20 -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$REPO/compare/$1...$BRANCH")" || return 2
  grep -Eq '"status": *"(ahead|identical)"' <<<"$out"
}

do_deploy() {
  local sha="$1"; valid_sha "$sha" || die "sha 必须是 40 位小写十六进制"
  if [ "${SKIP_BRANCH_CHECK:-0}" != 1 ]; then
    on_main "$sha" || die "$sha 不在 $REPO 的 $BRANCH 上（或查询 GitHub 失败），拒绝部署"
  fi
  migrate
  local prev; prev="$(current_dir)"
  if [ -n "$prev" ] && [ "$(cat "$prev/DEPLOYED_COMMIT" 2>/dev/null)" = "$sha" ] && [ "${FORCE:-0}" != 1 ]; then
    log "$sha 已经是当前版本，只做健康检查"; health; return
  fi

  new="$RELEASES/$sha-$(date +%Y%m%d%H%M%S)"; tmp="$(mktemp -d)"
  log "下载 $REPO@$sha"
  curl -fsSL --max-time 300 --proto '=https' -o "$tmp/src.tar.gz" "https://codeload.github.com/$REPO/tar.gz/$sha" \
    || die "下载失败"
  mkdir -p "$new"
  tar -xzf "$tmp/src.tar.gz" -C "$new" --strip-components=1 --no-same-owner --no-same-permissions \
    || { discard "$new"; die "解包失败"; }
  echo "$sha" > "$new/DEPLOYED_COMMIT"
  local f src
  for f in $CARRY; do
    src="$(carry_source "$prev" "$f")" || { discard "$new"; die "当前版本和健康历史里都找不到 $f，拒绝部署（不切换，线上不受影响）"; }
    [ "$src" = "$prev" ] || log "警告：当前版本 $prev 没有 $f，改从健康版本 $src 复制"
    cp -a "$src/$f" "$new/$f"
  done

  switch_to "$new"
  log "切换到 $new，开始重建"
  if rebuild && health; then
    mark_healthy "$new"; log "部署成功：$sha"; prune; return 0
  fi
  log "部署失败，回滚到 ${prev:-（无）}"
  [ -n "$prev" ] || die "没有可回滚的版本"
  switch_to "$prev"; discard "$new"
  rebuild && health && log "已回滚到 $prev" || log "回滚后健康检查仍失败，需要人工处理"
  exit 1
}

do_rollback() {   # 当前版本出栈，切到历史里上一个健康版本；连续 rollback 会一路往回退，不会来回切
  migrate
  local cur prev; cur="$(current_dir)"
  prev="$(grep -vxF "$cur" "$HEALTHY" | while read -r l; do [ -d "$l" ] && echo "$l"; done | tail -1 || true)"
  [ -n "$prev" ] || die "历史里没有更早的健康版本"
  log "回滚：$cur → $prev"
  switch_to "$prev"
  if rebuild && health; then
    { grep -vxF "$cur" "$HEALTHY" || true; } > "$HEALTHY.new"; mv -f "$HEALTHY.new" "$HEALTHY"
    mark_healthy "$prev"; log "回滚完成（$cur 已移出健康历史，prune 时删除）"
  else
    die "回滚后健康检查失败，需要人工处理"
  fi
}

do_status() {
  echo "role=$ROLE current=$(current_dir) commit=$(cat "$LIVE/DEPLOYED_COMMIT" 2>/dev/null || echo '?')"
  echo "健康历史（旧→新）："; cat "$HEALTHY" 2>/dev/null || true
}

exec 9>"$LOCK"; flock -n 9 || die "已有部署在跑"
case "${1:-}" in
  deploy)   [ $# -eq 2 ] || die "用法：deploy <sha>"; do_deploy "$2" ;;
  rollback) [ $# -eq 1 ] || die "用法：rollback"; do_rollback ;;
  status)   [ $# -eq 1 ] || die "用法：status"; do_status ;;
  *) die "用法：nanocode-deploy deploy <sha> | rollback | status" ;;
esac
