#!/usr/bin/env bash
# authorized_keys 的强制命令（restrict,command="/usr/local/sbin/nanocode-deploy-ssh"）。
# 客户端传什么命令都会落到 SSH_ORIGINAL_COMMAND 里；这里只认三种写法，其余一律拒绝。
set -euo pipefail
cmd="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$cmd" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo -n /usr/local/sbin/nanocode-deploy deploy "${BASH_REMATCH[1]}"
elif [[ "$cmd" == "status" || "$cmd" == "rollback" ]]; then
  exec sudo -n /usr/local/sbin/nanocode-deploy "$cmd"
fi
echo "拒绝：只允许 'deploy <40 位 sha>'、'status'、'rollback'" >&2
exit 1
