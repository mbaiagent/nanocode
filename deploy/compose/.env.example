# 复制成 .env 再改：cp .env.example .env
# 三个密钥都用随机值生成（十六进制，放进连接串不用转义）：
#   openssl rand -hex 32
NCS_SECRET_KEY=替换成-openssl-rand-hex-32-的输出
POSTGRES_PASSWORD=替换成-openssl-rand-hex-16-的输出
REDIS_PASSWORD=替换成-openssl-rand-hex-16-的输出

# 平台数据（工作区、沙箱策略）在宿主机上的目录；宿主机和容器内用同一个路径
NCS_HOST_DATA_DIR=/srv/nanocode

# 对外域名：DNS A 记录先指向这台机器，并开放 80 / 443。Caddy 自动申请 HTTPS 证书
NCS_DOMAIN=nanocode.example.com

# 登录：GitHub OAuth（GitHub → Settings → Developer settings → OAuth Apps → New OAuth App）
#   Homepage URL:               https://nanocode.example.com
#   Authorization callback URL: https://nanocode.example.com/auth/github/callback
NCS_AUTH=github
NCS_GITHUB_CLIENT_ID=
NCS_GITHUB_CLIENT_SECRET=
# 引导管理员：首次登录不需要邀请码。其他人要管理员在 /admin 生成的邀请码。也可写 id:<GitHub 数字 id>
# 必填才有第一个管理员：写你自己的 GitHub login（逗号分隔），或更稳的 id:<GitHub 数字 id>
NCS_ADMIN_GITHUB_LOGINS=
NCS_LOGIN_PER_MINUTE=10
# 只在冒烟测试时改成假的 GitHub（server/tests/fake_github.py）
NCS_GITHUB_OAUTH_URL=https://github.com
NCS_GITHUB_API_URL=https://api.github.com

# 控制面只听本机，由 Caddy 转发
NCS_HOST=127.0.0.1
NCS_PORT=8700
NCS_GATEWAY_PORT=8701
# 不用 GitHub、改用前面的认证代理时：NCS_AUTH=proxy 并设置
NCS_PROXY_SECRET=

# 宿主机上 PostgreSQL / Redis 的端口（只监听 127.0.0.1）
NCS_PG_PORT=15432
NCS_REDIS_PORT=16379

# 沙箱：每个会话一个容器
NCS_SANDBOX_IMAGE=nanocode-sandbox:latest
NCS_DOCKER_RUNTIME=
# #123：沙箱网桥名 / 网段。宿主机防火墙（../firewall/）按它们只放行网关端口，改了这里也要用同样的值重跑防火墙脚本
NCS_DOCKER_BRIDGE=ncs-sbx0
NCS_DOCKER_SUBNET=172.30.250.0/24
NCS_SANDBOX_CPU=1
NCS_SANDBOX_MEMORY=2Gi
NCS_MAX_SANDBOXES=50
# #119 资源调参。默认值 = 原来的行为；1 GB 小机器推荐值见 README「低配单机」
NCS_SANDBOX_TMPFS=
NCS_SANDBOX_PIDS=512
NCS_IDLE_TIMEOUT=1800
NCS_MAX_CONNECTIONS=256
NCS_DAILY_TOKENS=2000000
NCS_RPM=30
NCS_MAX_OUTPUT_TOKENS=8192
NCS_PG_SHARED_BUFFERS=128MB
NCS_PG_MAX_CONNECTIONS=100
NCS_REDIS_MAXMEMORY=0
NCS_PG_MEM_LIMIT=0
NCS_REDIS_MEM_LIMIT=0
NCS_PLATFORM_MEM_LIMIT=0
NCS_MAX_SESSIONS_PER_USER=3

# 演示模型（不需要 Key，便于冒烟测试）。正式使用时用户在页面里添加自己的 Key（BYO），可以关掉
NCS_ENABLE_MOCK_MODEL=true

# 沙箱放到另一台机器（见 ../sandbox-host/README.md）：NCS_LAUNCHER=remote，并填下面几项。
# NCS_GATEWAY_HOST 是本机的隧道地址（例如 WireGuard 10.77.0.1）；127.0.0.1 时 docker 启动器会自动换成沙箱网桥地址
NCS_LAUNCHER=docker
NCS_REMOTE_AGENT_URL=
NCS_REMOTE_AGENT_SECRET=
NCS_REMOTE_GATEWAY_URL=
NCS_GATEWAY_HOST=127.0.0.1

# 工作区快照（可选，docs/distributed-deploy.md 第十节）。off = 工作区只在本机 / 沙箱主机磁盘上。
# s3：停止 / 回收 / 删除时打包存进 S3 兼容对象存储（Backblaze B2、MinIO、R2…），本地没了自动恢复。
# 密钥只写在这里（平台机，chmod 600），沙箱主机不需要；值不要提交到仓库。
NCS_OBJECT_STORE=off
NCS_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
NCS_S3_REGION=<region>
NCS_S3_BUCKET=<bucket>
NCS_S3_ACCESS_KEY_ID=
NCS_S3_SECRET_ACCESS_KEY=
NCS_S3_PREFIX=snapshots
NCS_SNAPSHOT_KEEP=3
NCS_SNAPSHOT_MAX_BYTES=1Gi
# 追加的忽略规则（默认已忽略 node_modules、.venv、__pycache__、.cache 等），逗号分隔的文件名通配
NCS_SNAPSHOT_IGNORE=
# 删除会话时连云端快照一起删（默认）；关掉后可用 NCS_SNAPSHOT_ON_DELETE=true 在删除前再存最后一份
NCS_SNAPSHOT_PURGE_ON_DELETE=true
NCS_SNAPSHOT_ON_DELETE=false
