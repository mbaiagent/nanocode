# Caddy：自动申请和续期 HTTPS 证书（Let's Encrypt），反向代理到只监听 127.0.0.1 的控制面。
# NCS_DOMAIN 的 DNS 要先指向这台机器，并开放 80 / 443。
# 可选组件：docker compose --profile caddy up -d。机器上已经有 nginx 的话用 nginx.example.conf。
{
	# host 网络下默认会在宿主机 localhost:2019 开管理 API，本机任何进程都能改反代配置：关掉
	admin off
}

{$NCS_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{$NCS_PORT} {
		# 事件流（SSE）不缓冲，逐条转发
		flush_interval -1
	}
}
