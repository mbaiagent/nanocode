# 沙箱主机的配置。chmod 600 .env，不要提交到仓库。
# 和平台那边 .env 里的 NCS_REMOTE_AGENT_SECRET 必须一样（openssl rand -hex 32）
NCS_REMOTE_AGENT_SECRET=替换成-openssl-rand-hex-32-的输出
# 代理只监听本机的 WireGuard 地址（不能是 0.0.0.0）
NCS_AGENT_BIND=10.77.0.2:8790
# 平台那边的模型网关（平台 .env 里 NCS_GATEWAY_HOST=10.77.0.1）
NCS_AGENT_UPSTREAM_GATEWAY=10.77.0.1:8701
# 网关中继监听的地址；空 = 沙箱网桥地址（NCS_DOCKER_SUBNET 的 .1）
NCS_AGENT_RELAY_BIND=
# 网关中继的名额：全局上限 / 每个沙箱上限 / 空闲多少秒断开（防一个沙箱占满所有人的中继）
NCS_AGENT_RELAY_MAX_CONNECTIONS=128
NCS_AGENT_RELAY_PER_SANDBOX=16
NCS_AGENT_RELAY_IDLE_TIMEOUT=300
NCS_GATEWAY_PORT=8701
# 出站代理：沙箱经它访问公网 HTTP/HTTPS（web_fetch、web_search、pip、git），内网 / 元数据 / 本机地址一律拒绝。
# 默认关。生产打开前提见 docs/distributed-deploy.md「出站代理」（#134）；打开时防火墙脚本要带 NCS_EGRESS_PORT
NCS_EGRESS_PROXY=0
NCS_EGRESS_PORT=3128
NCS_EGRESS_ALLOWED_PORTS=80,443
NCS_EGRESS_MAX_CONNECTIONS=64
NCS_EGRESS_PER_SANDBOX=8
NCS_EGRESS_IDLE_TIMEOUT=120
# 只放行这些域名（逗号分隔，含子域名；空 = 不限）/ 一律拒绝这些域名
NCS_EGRESS_ALLOW_DOMAINS=
NCS_EGRESS_DENY_DOMAINS=
# 额外拦住的网段：至少写上 WireGuard 网段（私有网段本来就拦，写上防止以后换成别的网段）
NCS_EGRESS_BLOCK_NETWORKS=10.77.0.0/24
# 沙箱最长存活秒数，和平台的 NCS_TOKEN_TTL 一致
NCS_TOKEN_TTL=43200
NCS_HOST_DATA_DIR=/srv/nanocode
NCS_SANDBOX_IMAGE=nanocode-sandbox:latest
NCS_DOCKER_RUNTIME=
NCS_DOCKER_BRIDGE=ncs-sbx0
NCS_DOCKER_SUBNET=172.30.250.0/24
# 1 GB 内存的机器：每个沙箱 384Mi、/tmp 96m，同时跑 1-2 个（平台那边 NCS_MAX_SANDBOXES=2）
NCS_SANDBOX_CPU=1
NCS_SANDBOX_MEMORY=384Mi
NCS_SANDBOX_TMPFS=96m
NCS_SANDBOX_PIDS=256
NCS_MAX_CONNECTIONS=64
NCS_AGENT_MEM_LIMIT=128m
